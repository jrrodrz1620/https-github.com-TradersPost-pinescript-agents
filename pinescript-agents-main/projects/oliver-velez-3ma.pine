//@version=6
// Oliver Velez 3 Moving Average System
// Based on: "The Only 3 Moving Averages You Need"
// MAs: 8 EMA (short-term), 20 SMA (key level), 50 SMA (long-term)

strategy("Oliver Velez 3MA System", shorttitle="OV 3MA", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.1)

// ============================================================================
// INPUTS
// ============================================================================

grpMA = "Moving Average Settings"
ema8Len    = input.int(8,  "EMA Length (Short-Term)",  minval=1, group=grpMA, tooltip="8 EMA — reacts fast to price, key for short-term traders")
sma20Len   = input.int(20, "SMA Length (Key Level)",   minval=1, group=grpMA, tooltip="20 SMA — THE key average; short-term oriented stocks react here")
sma50Len   = input.int(50, "SMA Length (Long-Term)",   minval=1, group=grpMA, tooltip="50 SMA — once price reaches here you are in the long-term position")

grpSignals = "Signal Settings"
useEmaEntry  = input.bool(true,  "Entry on 8 EMA Pullback",  group=grpSignals, tooltip="Signal when price pulls back to and bounces off the 8 EMA")
useSmaEntry  = input.bool(true,  "Entry on 20 SMA Pullback", group=grpSignals, tooltip="Signal when price pulls back to and bounces off the 20 SMA")
requireAlign = input.bool(true,  "Require Full MA Alignment", group=grpSignals, tooltip="Only take entries when all 3 MAs are aligned in the trend direction")

grpVisual = "Visual Settings"
showBg       = input.bool(true,  "Show Background Color",  group=grpVisual)
showLabels   = input.bool(true,  "Show Signal Labels",     group=grpVisual)
showPanel    = input.bool(true,  "Show Info Panel",        group=grpVisual)

grpColors = "Colors"
colorEma8    = input.color(color.new(#FF6B35, 0),   "8 EMA Color",          group=grpColors)
colorSma20   = input.color(color.new(#00D4AA, 0),   "20 SMA Color",         group=grpColors)
colorSma50   = input.color(color.new(#7B68EE, 0),   "50 SMA Color",         group=grpColors)
colorBull    = input.color(color.new(#26A69A, 8),   "Bullish BG Color",     group=grpColors)
colorBear    = input.color(color.new(#EF5350, 8),   "Bearish BG Color",     group=grpColors)

// ============================================================================
// CALCULATIONS
// ============================================================================

ema8  = ta.ema(close, ema8Len)
sma20 = ta.sma(close, sma20Len)
sma50 = ta.sma(close, sma50Len)

// Trend alignment
bullAlign = ema8 > sma20 and sma20 > sma50 and close > ema8
bearAlign = ema8 < sma20 and sma20 < sma50 and close < ema8

// Partial alignment (2 of 3)
bullPartial = ema8 > sma20 and close > sma20
bearPartial = ema8 < sma20 and close < sma20

// Pullback detection — price touched MA and is now bouncing
ema8Touch  = low <= ema8  and close > ema8  and close > open
sma20Touch = low <= sma20 and close > sma20 and close > open
ema8Short  = high >= ema8  and close < ema8  and close < open
sma20Short = high >= sma20 and close < sma20 and close < open

// Entry conditions
longEma8  = useEmaEntry  and ema8Touch  and (requireAlign ? bullAlign : bullPartial)
longSma20 = useSmaEntry  and sma20Touch and (requireAlign ? bullAlign : bullPartial)
shortEma8  = useEmaEntry  and ema8Short  and (requireAlign ? bearAlign : bearPartial)
shortSma20 = useSmaEntry  and sma20Short and (requireAlign ? bearAlign : bearPartial)

longSignal  = longEma8  or longSma20
shortSignal = shortEma8 or shortSma20

// Exit: price crosses back below 20 SMA (for longs) or above 20 SMA (for shorts)
longExit  = ta.crossunder(close, sma20)
shortExit = ta.crossover(close, sma20)

// ============================================================================
// STRATEGY
// ============================================================================

if longSignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if shortSignal and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0 and longExit
    strategy.close("Long")

if strategy.position_size < 0 and shortExit
    strategy.close("Short")

// ============================================================================
// PLOTS
// ============================================================================

plot(ema8,  "8 EMA",   color=colorEma8,  linewidth=2)
plot(sma20, "20 SMA",  color=colorSma20, linewidth=2)
plot(sma50, "50 SMA",  color=colorSma50, linewidth=2)

// Background
bgColor = showBg ? (bullAlign ? colorBull : bearAlign ? colorBear : na) : na
bgcolor(bgColor)

// Signal labels
if showLabels and longSignal
    label.new(bar_index, low, longEma8 ? "8E" : "20S", color=color.new(#26A69A, 0), textcolor=color.white, style=label.style_label_up, size=size.small)

if showLabels and shortSignal
    label.new(bar_index, high, shortEma8 ? "8E" : "20S", color=color.new(#EF5350, 0), textcolor=color.white, style=label.style_label_down, size=size.small)

// ============================================================================
// INFO PANEL
// ============================================================================

if showPanel and barstate.islast
    tbl = table.new(position.top_right, 2, 6, border_width=1, border_color=color.new(color.gray, 60), frame_width=1, frame_color=color.new(color.gray, 40))

    table.cell(tbl, 0, 0, "OV 3MA System", bgcolor=color.new(#1E1E2E, 0), text_color=color.white, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 0, "",              bgcolor=color.new(#1E1E2E, 0))

    trendState = bullAlign ? "BULLISH ▲" : bearAlign ? "BEARISH ▼" : "NEUTRAL —"
    trendCol   = bullAlign ? color.new(#26A69A, 0) : bearAlign ? color.new(#EF5350, 0) : color.new(color.gray, 0)
    table.cell(tbl, 0, 1, "Trend",    bgcolor=color.new(#13131F, 0), text_color=color.new(color.gray, 0), text_size=size.small)
    table.cell(tbl, 1, 1, trendState, bgcolor=color.new(#13131F, 0), text_color=trendCol, text_size=size.small)

    table.cell(tbl, 0, 2, "8 EMA",    bgcolor=color.new(#13131F, 0), text_color=color.new(color.gray, 0), text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(ema8, format.mintick), bgcolor=color.new(#13131F, 0), text_color=colorEma8, text_size=size.small)

    table.cell(tbl, 0, 3, "20 SMA",   bgcolor=color.new(#13131F, 0), text_color=color.new(color.gray, 0), text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(sma20, format.mintick), bgcolor=color.new(#13131F, 0), text_color=colorSma20, text_size=size.small)

    table.cell(tbl, 0, 4, "50 SMA",   bgcolor=color.new(#13131F, 0), text_color=color.new(color.gray, 0), text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(sma50, format.mintick), bgcolor=color.new(#13131F, 0), text_color=colorSma50, text_size=size.small)

    posState = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    posCol   = strategy.position_size > 0 ? color.new(#26A69A, 0) : strategy.position_size < 0 ? color.new(#EF5350, 0) : color.new(color.gray, 0)
    table.cell(tbl, 0, 5, "Position", bgcolor=color.new(#13131F, 0), text_color=color.new(color.gray, 0), text_size=size.small)
    table.cell(tbl, 1, 5, posState,   bgcolor=color.new(#13131F, 0), text_color=posCol, text_size=size.small)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(longEma8,   "Long — 8 EMA Pullback",   "OV 3MA: Long signal — price bounced off 8 EMA")
alertcondition(longSma20,  "Long — 20 SMA Pullback",  "OV 3MA: Long signal — price bounced off 20 SMA")
alertcondition(shortEma8,  "Short — 8 EMA Rejection", "OV 3MA: Short signal — price rejected at 8 EMA")
alertcondition(shortSma20, "Short — 20 SMA Rejection","OV 3MA: Short signal — price rejected at 20 SMA")
alertcondition(bullAlign,  "Full Bull Alignment",      "OV 3MA: All 3 MAs bullishly aligned")
alertcondition(bearAlign,  "Full Bear Alignment",      "OV 3MA: All 3 MAs bearishly aligned")
