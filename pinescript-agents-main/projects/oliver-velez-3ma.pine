//@version=6
strategy("Oliver Velez 3MA", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.1)

// ── Inputs ───────────────────────────────────────────────────────────────────
ema8Len  = input.int(8,  "8 EMA",  minval=1, group="MAs")
sma20Len = input.int(20, "20 SMA", minval=1, group="MAs")
sma50Len = input.int(50, "50 SMA", minval=1, group="MAs")

entryMode = input.string("Both", "Entry Mode",
     options=["Crossover", "Pullback", "Both"], group="Strategy",
     tooltip="Crossover: trade when 8 EMA crosses 20 SMA. Pullback: trade when price bounces off 8 EMA or 20 SMA. Both: either signal.")
exitOn = input.string("8 EMA", "Exit On",
     options=["8 EMA", "20 SMA"], group="Strategy",
     tooltip="Close trade when price closes on the wrong side of this MA.")

showBg     = input.bool(true, "Background",    group="Display")
showLabels = input.bool(true, "Signal Labels", group="Display")
showPanel  = input.bool(true, "Info Panel",    group="Display")

// ── Calculations ─────────────────────────────────────────────────────────────
ema8  = ta.ema(close, ema8Len)
sma20 = ta.sma(close, sma20Len)
sma50 = ta.sma(close, sma50Len)

bullTrend = ema8 > sma20
bearTrend = ema8 < sma20
fullBull  = ema8 > sma20 and sma20 > sma50
fullBear  = ema8 < sma20 and sma20 < sma50

// Crossover signals
crossLong  = ta.crossover(ema8, sma20)
crossShort = ta.crossunder(ema8, sma20)

// Pullback signals — price tagged MA and closed back on the right side
pbLong  = (low <= ema8  and close > ema8  or low <= sma20 and close > sma20) and close > open and bullTrend
pbShort = (high >= ema8 and close < ema8  or high >= sma20 and close < sma20) and close < open and bearTrend

longEntry  = switch entryMode
    "Crossover" => crossLong
    "Pullback"  => pbLong
    => crossLong or pbLong

shortEntry = switch entryMode
    "Crossover" => crossShort
    "Pullback"  => pbShort
    => crossShort or pbShort

longExit  = exitOn == "8 EMA" ? ta.crossunder(close, ema8)  : ta.crossunder(close, sma20)
shortExit = exitOn == "8 EMA" ? ta.crossover(close, ema8)   : ta.crossover(close, sma20)

// ── Strategy ─────────────────────────────────────────────────────────────────
if longEntry
    strategy.entry("Long", strategy.long)
if shortEntry
    strategy.entry("Short", strategy.short)
if strategy.position_size > 0 and longExit
    strategy.close("Long")
if strategy.position_size < 0 and shortExit
    strategy.close("Short")

// ── Plots ────────────────────────────────────────────────────────────────────
plot(ema8,  "8 EMA",  color=#FF6B35, linewidth=2)
plot(sma20, "20 SMA", color=#00D4AA, linewidth=2)
plot(sma50, "50 SMA", color=#7B68EE, linewidth=2)

bgcolor(showBg ? (fullBull ? color.new(#26A69A, 88) : fullBear ? color.new(#EF5350, 88) : na) : na)

if showLabels and longEntry
    label.new(bar_index, low,  crossLong  ? "✕" : "↑", color=#26A69A, textcolor=color.white, style=label.style_label_up,   size=size.small)
if showLabels and shortEntry
    label.new(bar_index, high, crossShort ? "✕" : "↓", color=#EF5350, textcolor=color.white, style=label.style_label_down, size=size.small)

// ── Panel ────────────────────────────────────────────────────────────────────
if showPanel and barstate.islast
    t = table.new(position.top_right, 2, 5,
         border_width=1, border_color=color.new(color.gray, 70),
         frame_width=1,  frame_color=color.new(color.gray, 50))

    table.cell(t, 0, 0, "OV 3MA", bgcolor=#1E1E2E, text_color=color.white, text_size=size.small, text_halign=text.align_center)
    table.cell(t, 1, 0, "",       bgcolor=#1E1E2E)

    trendTxt = fullBull ? "BULL ▲" : fullBear ? "BEAR ▼" : bullTrend ? "BIAS ▲" : bearTrend ? "BIAS ▼" : "FLAT —"
    trendClr = fullBull ? #26A69A  : fullBear ? #EF5350  : color.gray
    table.cell(t, 0, 1, "Trend",  bgcolor=#13131F, text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 1, trendTxt, bgcolor=#13131F, text_color=trendClr,   text_size=size.small)

    table.cell(t, 0, 2, "8 EMA",  bgcolor=#13131F, text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(ema8,  format.mintick), bgcolor=#13131F, text_color=#FF6B35, text_size=size.small)

    table.cell(t, 0, 3, "20 SMA", bgcolor=#13131F, text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(sma20, format.mintick), bgcolor=#13131F, text_color=#00D4AA, text_size=size.small)

    table.cell(t, 0, 4, "50 SMA", bgcolor=#13131F, text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(sma50, format.mintick), bgcolor=#13131F, text_color=#7B68EE, text_size=size.small)

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(longEntry,  "Long Entry",       "OV 3MA: Long signal")
alertcondition(shortEntry, "Short Entry",      "OV 3MA: Short signal")
alertcondition(fullBull,   "Full Bull Align",  "OV 3MA: All 3 MAs bullish")
alertcondition(fullBear,   "Full Bear Align",  "OV 3MA: All 3 MAs bearish")
