// © Open-source re-implementation of "Phantom Flow"-style Smart Money Concepts
// Implemented by Pine Script Development Assistant
//
// Phantom Flow SMC — Strategy
// Trading rules built on the same Smart Money structure as the indicator:
//   ENTRY  long  : structure flips bullish (BOS/CHoCH up) while price sits in
//                  the DISCOUNT half of the active swing range; optional fresh
//                  bullish FVG + higher-timeframe trend confirmation.
//   ENTRY  short : mirror — bearish flip in the PREMIUM half.
//   STOP        : beyond the opposing swing (structure stop) or ATR.
//   MANAGEMENT  : optional partial take-profit at 1R, breakeven move, and an
//                  ATR trailing stop on the runner.
//   TARGET      : fixed R:R multiple of the initial stop distance.
//
// Defaults are tuned for NQ/MNQ futures. Named entry/exit signals export
// cleanly into the nq-walkforward analyzer (Strategy Tester → Export → List of
// Trades). Non-repainting: structure comes from confirmed pivots, HTF data is
// pulled with lookahead off on the prior bar, entries fire on bar close.

//@version=6
strategy("Phantom Flow SMC Strategy", overlay=true, initial_capital=50000,
         default_qty_type=strategy.fixed, default_qty_value=2,
         commission_type=strategy.commission.cash_per_contract, commission_value=2.0,
         slippage=1, calc_on_every_tick=false, pyramiding=0)

// ============================================================================
// INPUT SETTINGS
// ============================================================================

// Structure
grpMS = "Market Structure"
swingLength = input.int(10, "Swing Pivot Length", minval=2, maxval=50, group=grpMS)

// Higher-Timeframe Trend Filter
grpHTF = "HTF Trend Filter"
useHTF      = input.bool(true, "Require HTF Trend Agreement", group=grpHTF, tooltip="Longs only when HTF close is above its EMA; shorts only when below.")
htfTf       = input.timeframe("60", "HTF Timeframe", group=grpHTF)
htfEmaLen   = input.int(50, "HTF EMA Length", minval=5, group=grpHTF)

// Entry Filters
grpEntry = "Entry Filters"
useLocation = input.bool(true, "Require Discount/Premium Location", group=grpEntry, tooltip="Longs only in discount, shorts only in premium.")
requireFVG  = input.bool(false, "Require Fresh FVG Confirmation", group=grpEntry)
fvgAtrMult  = input.float(0.25, "Min FVG Size (× ATR)", minval=0.0, step=0.05, group=grpEntry)
allowLongs  = input.bool(true, "Allow Longs", inline="dir", group=grpEntry)
allowShorts = input.bool(true, "Allow Shorts", inline="dir", group=grpEntry)

// Session
grpSess = "Session Filter"
useSession   = input.bool(true, "Restrict to Session", group=grpSess)
sessionWin   = input.session("0930-1600", "Session (exchange time)", group=grpSess)
closeAtEnd   = input.bool(true, "Flatten at Session End", group=grpSess)

// Risk & Trade Management
grpRisk = "Risk & Management"
stopMode    = input.string("Structure", "Stop Type", ["Structure", "ATR"], group=grpRisk)
atrLength   = input.int(14, "ATR Length", minval=2, group=grpRisk)
atrMult     = input.float(1.5, "ATR Stop Multiplier", minval=0.2, step=0.1, group=grpRisk)
structBuf   = input.float(0.25, "Structure Stop Buffer (× ATR)", minval=0.0, step=0.05, group=grpRisk)
rrRatio     = input.float(2.0, "Final Reward : Risk", minval=0.5, step=0.5, group=grpRisk)
usePartial  = input.bool(true, "Take Partial at 1R", group=grpRisk, tooltip="Scale out half the position at +1R.")
partialPct  = input.float(50, "Partial Size (%)", minval=10, maxval=90, step=5, group=grpRisk)
useBE       = input.bool(true, "Move Stop to Breakeven", group=grpRisk)
beTrigger   = input.float(1.0, "Breakeven Trigger (R)", minval=0.2, step=0.1, group=grpRisk)
useTrail    = input.bool(false, "ATR Trailing Stop", group=grpRisk)
trailMult   = input.float(2.0, "Trail Distance (× ATR)", minval=0.5, step=0.1, group=grpRisk)

// ============================================================================
// CORE CALCULATIONS
// ============================================================================

atr = ta.atr(atrLength)

ph = ta.pivothigh(high, swingLength, swingLength)
pl = ta.pivotlow(low, swingLength, swingLength)

var float upper     = na
var float lower     = na
var int   osMode    = 0
var float rangeHigh = na
var float rangeLow  = na

if not na(ph)
    upper := ph
    rangeHigh := ph
if not na(pl)
    lower := pl
    rangeLow := pl

equilibrium = (not na(rangeHigh) and not na(rangeLow)) ? (rangeHigh + rangeLow) / 2 : na

// Structure breaks (single trigger on the breaking bar)
bullBreak = not na(upper) and close > upper and close[1] <= upper
bearBreak = not na(lower) and close < lower and close[1] >= lower

// A structure shift ARMS a side; the actual entry waits for a pullback into the
// favorable half of the range (a bullish break closes near the highs = premium,
// so requiring discount AT the break bar would almost never fire — we enter the
// retracement instead).
var bool armedLong  = false
var bool armedShort = false
if bullBreak
    osMode := 1
    armedLong  := true
    armedShort := false
if bearBreak
    osMode := -1
    armedShort := true
    armedLong  := false

// Higher-timeframe trend (prior HTF bar + lookahead off = non-repainting)
htfClose = request.security(syminfo.tickerid, htfTf, close[1], lookahead=barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen)[1], lookahead=barmerge.lookahead_off)
htfBull  = htfClose > htfEma
htfBear  = htfClose < htfEma

// Fresh imbalances for optional confirmation
bullFVG = low > high[2] and (low - high[2]) > atr * fvgAtrMult
bearFVG = high < low[2] and (low[2] - high) > atr * fvgAtrMult
var bool freshBullFVG = false
var bool freshBearFVG = false
if bullFVG
    freshBullFVG := true
if bearFVG
    freshBearFVG := true
if bearBreak
    freshBullFVG := false
if bullBreak
    freshBearFVG := false

// ============================================================================
// ENTRY LOGIC
// ============================================================================

inDiscount = na(equilibrium) or not useLocation ? true : close <= equilibrium
inPremium  = na(equilibrium) or not useLocation ? true : close >= equilibrium
inSession  = not useSession or not na(time(timeframe.period, sessionWin))

// Enter on the pullback after a structure shift armed the side.
longSignal  = allowLongs and armedLong and inDiscount and (not requireFVG or freshBullFVG) and (not useHTF or htfBull) and inSession
shortSignal = allowShorts and armedShort and inPremium and (not requireFVG or freshBearFVG) and (not useHTF or htfBear) and inSession

// Initial stop prices computed at signal time
longStop  = stopMode == "ATR" ? close - atr * atrMult : (na(lower) ? close - atr * atrMult : lower - atr * structBuf)
shortStop = stopMode == "ATR" ? close + atr * atrMult : (na(upper) ? close + atr * atrMult : upper + atr * structBuf)
longRisk  = close - longStop
shortRisk = shortStop - close

// ============================================================================
// TRADE STATE  (entry price, initial risk, working stop)
// ============================================================================

var float entryPx  = na
var float initRisk = na
var float workStop = na

// ── Entries (flat only; pyramiding disabled) ──
if longSignal and longRisk > 0 and strategy.position_size == 0
    strategy.entry("PF Long", strategy.long, comment="PF Long")
    entryPx  := close
    initRisk := longRisk
    workStop := longStop
    armedLong := false

if shortSignal and shortRisk > 0 and strategy.position_size == 0
    strategy.entry("PF Short", strategy.short, comment="PF Short")
    entryPx  := close
    initRisk := shortRisk
    workStop := shortStop
    armedShort := false

// ── Manage open long ──
if strategy.position_size > 0 and not na(entryPx)
    if useBE and high >= entryPx + initRisk * beTrigger
        workStop := math.max(workStop, entryPx)
    if useTrail
        workStop := math.max(workStop, close - atr * trailMult)
    tp1   = entryPx + initRisk
    tpFin = entryPx + initRisk * rrRatio
    if usePartial
        strategy.exit("L-TP1", from_entry="PF Long", qty_percent=partialPct, limit=tp1, stop=workStop, comment_profit="TP1", comment_loss="SL")
    strategy.exit("L-Exit", from_entry="PF Long", limit=tpFin, stop=workStop, comment_profit="TP", comment_loss="SL")

// ── Manage open short ──
if strategy.position_size < 0 and not na(entryPx)
    if useBE and low <= entryPx - initRisk * beTrigger
        workStop := math.min(workStop, entryPx)
    if useTrail
        workStop := math.min(workStop, close + atr * trailMult)
    tp1   = entryPx - initRisk
    tpFin = entryPx - initRisk * rrRatio
    if usePartial
        strategy.exit("S-TP1", from_entry="PF Short", qty_percent=partialPct, limit=tp1, stop=workStop, comment_profit="TP1", comment_loss="SL")
    strategy.exit("S-Exit", from_entry="PF Short", limit=tpFin, stop=workStop, comment_profit="TP", comment_loss="SL")

// ── Reset state when flat ──
if strategy.position_size == 0
    entryPx  := na
    initRisk := na
    workStop := na

// Flatten at session end if requested
sessionNow = not na(time(timeframe.period, sessionWin))
sessionEnd = closeAtEnd and useSession and sessionNow[1] and not sessionNow
if sessionEnd
    strategy.close_all(comment="Session End")

// ============================================================================
// VISUALS
// ============================================================================

plotshape(longSignal,  title="Long",  style=shape.triangleup,   location=location.belowbar, color=color.teal, size=size.small)
plotshape(shortSignal, title="Short", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small)
plot(equilibrium, "Equilibrium", color=color.new(color.gray, 50), style=plot.style_stepline)
plot(strategy.position_size != 0 ? workStop : na, "Working Stop", color=color.new(color.red, 0), style=plot.style_linebr)
bgcolor(useSession and sessionNow ? color.new(color.blue, 94) : na, title="Session")
