// ============================================================================
// 15-MINUTE OPENING RANGE BREAKOUT (ORB) INDICATOR
// ----------------------------------------------------------------------------
// 1. Marks the high and low of the first 15 minutes after the 9:30 AM
//    (New York) open, i.e. the 9:30-9:45 range.
// 2. On the execution chart (designed for the 2-minute chart) it waits for a
//    candle to CLOSE above the range high (BUY) or below the range low (SELL).
// 3. The breakout candle must also pass a volume confirmation filter
//    (volume > average volume x multiplier).
// 4. The signal fires at the close of the breakout candle - no repainting.
//
// The opening range is pulled from the 15-minute timeframe with a
// non-repainting request.security() call, so the range is exact even though
// 15 minutes is not a multiple of the 2-minute chart.
// ============================================================================

//@version=6
indicator("15m ORB Breakout Signals", shorttitle = "ORB 15m", overlay = true, max_boxes_count = 500)

// ============================================================================
// INPUTS
// ============================================================================

const string GRP_OR  = "Opening Range"
const string GRP_SIG = "Breakout Signals"
const string GRP_VOL = "Volume Confirmation"
const string GRP_VIS = "Visuals"

orTf       = input.timeframe("15", "Opening range length", group = GRP_OR, tooltip = "Timeframe of the opening range candle. 15 = the first 15 minutes.")
orHour     = input.int(9, "Open hour", minval = 0, maxval = 23, inline = "open", group = GRP_OR)
orMinute   = input.int(30, "Minute", minval = 0, maxval = 59, inline = "open", group = GRP_OR)
tz         = input.string("America/New_York", "Timezone", group = GRP_OR)

direction   = input.string("Both", "Signal direction", options = ["Both", "Buy only", "Sell only"], group = GRP_SIG)
entryWindow = input.session("0945-1500", "Signal window", group = GRP_SIG, tooltip = "Breakout signals are only given inside this window (timezone above).")
rangeWindow = input.session("0930-1600", "Show range during", group = GRP_SIG, tooltip = "The opening range lines and box are drawn inside this window.")
maxSignals  = input.int(1, "Max signals per day", minval = 1, group = GRP_SIG, tooltip = "1 = only the first qualifying breakout of the day.")
freshCross  = input.bool(false, "Require fresh close through level", group = GRP_SIG, tooltip = "ON: the previous candle must have closed inside the range. OFF: any candle closing outside the range with volume confirmation qualifies.")

useVolume  = input.bool(true, "Require volume confirmation", group = GRP_VOL)
volLen     = input.int(20, "Volume average length", minval = 1, group = GRP_VOL)
volMult    = input.float(1.5, "Volume multiplier", minval = 0.1, step = 0.1, group = GRP_VOL, tooltip = "Breakout candle volume must be greater than the average of the previous N candles times this multiplier.")

showBox    = input.bool(true, "Show opening range box", group = GRP_VIS)
showLevels = input.bool(true, "Show range high / low lines", group = GRP_VIS)
showReject = input.bool(true, "Mark low-volume breakouts", group = GRP_VIS)
showTable  = input.bool(true, "Show info table", group = GRP_VIS)
colHigh    = input.color(color.new(#26a69a, 0), "Range high", inline = "c", group = GRP_VIS)
colLow     = input.color(color.new(#ef5350, 0), "Range low", inline = "c", group = GRP_VIS)
colBox     = input.color(color.new(#2962ff, 85), "Box", inline = "c", group = GRP_VIS)

// ============================================================================
// VALIDATION
// ============================================================================

if not timeframe.isintraday or timeframe.in_seconds() > timeframe.in_seconds(orTf)
    runtime.error("Use an intraday chart at or below the opening range timeframe (the 2-minute chart is recommended).")

// ============================================================================
// OPENING RANGE (non-repainting: last COMPLETED opening-range-timeframe candle)
// ============================================================================

[htfHigh, htfLow, htfTime] = request.security(syminfo.tickerid, orTf, [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)

var float  orHigh       = na
var float  orLow        = na
var int    orTime       = na
var int    signalsToday = 0
var string lastSignal   = "None"
var box    orBox        = na

isOrCandle = not na(htfTime) and hour(htfTime, tz) == orHour and minute(htfTime, tz) == orMinute
newRange   = isOrCandle and (na(orTime) or htfTime != orTime)

if newRange
    orHigh       := htfHigh
    orLow        := htfLow
    orTime       := htfTime
    signalsToday := 0
    lastSignal   := "None"
    if showBox
        orBox := box.new(orTime, orHigh, time, orLow, xloc = xloc.bar_time, border_color = color.new(#2962ff, 40), bgcolor = colBox, text = "ORB 15m", text_color = color.new(#2962ff, 20), text_size = size.small, text_halign = text.align_left, text_valign = text.align_top)

inEntryWindow = not na(time(timeframe.period, entryWindow, tz))
inRangeWindow = not na(time(timeframe.period, rangeWindow, tz))

// The range is "live" from the moment it is known until the end of the range window that day
rangeLive = not na(orHigh) and not na(orTime) and inRangeWindow and (time - orTime) < 12 * 60 * 60 * 1000

if rangeLive and showBox and not na(orBox)
    orBox.set_right(time)

orMid   = (orHigh + orLow) / 2
orRange = orHigh - orLow

// ============================================================================
// VOLUME CONFIRMATION
// ============================================================================

volAvg   = ta.sma(volume, volLen)[1]
volRatio = volAvg > 0 ? volume / volAvg : na
volOk    = not useVolume or (not na(volRatio) and volRatio > volMult)

// ============================================================================
// BREAKOUT SIGNALS (evaluated on candle close)
// ============================================================================

closeAbove = close > orHigh and (not freshCross or close[1] <= orHigh)
closeBelow = close < orLow  and (not freshCross or close[1] >= orLow)

canSignal  = rangeLive and inEntryWindow and signalsToday < maxSignals and barstate.isconfirmed
allowBuy   = direction != "Sell only"
allowSell  = direction != "Buy only"

buySignal  = canSignal and allowBuy  and closeAbove and volOk
sellSignal = canSignal and allowSell and closeBelow and volOk

if buySignal
    signalsToday += 1
    lastSignal   := "BUY @ " + str.tostring(close, format.mintick)
    alert('{"ticker":"' + syminfo.ticker + '","action":"buy","price":"' + str.tostring(close, format.mintick) + '"}', alert.freq_once_per_bar_close)

if sellSignal
    signalsToday += 1
    lastSignal   := "SELL @ " + str.tostring(close, format.mintick)
    alert('{"ticker":"' + syminfo.ticker + '","action":"sell","price":"' + str.tostring(close, format.mintick) + '"}', alert.freq_once_per_bar_close)

// ============================================================================
// VISUALS
// ============================================================================

plot(showLevels and rangeLive ? orHigh : na, "ORB High", colHigh, 2, plot.style_linebr)
plot(showLevels and rangeLive ? orLow  : na, "ORB Low",  colLow,  2, plot.style_linebr)
plot(showLevels and rangeLive ? orMid  : na, "ORB Mid",  color.new(color.gray, 40), 1, plot.style_linebr)

plotshape(buySignal,  "Buy signal",  shape.labelup,   location.belowbar, color.new(#26a69a, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(sellSignal, "Sell signal", shape.labeldown, location.abovebar, color.new(#ef5350, 0), text = "SELL", textcolor = color.white, size = size.small)

// Highlight breakout candles that closed outside the range but FAILED volume confirmation
rejected = showReject and canSignal and useVolume and not volOk and ((allowBuy and closeAbove) or (allowSell and closeBelow))
plotshape(rejected, "Low-volume breakout (ignored)", shape.xcross, location.abovebar, color.new(color.orange, 30), size = size.tiny)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(buySignal,  "ORB BUY",  "ORB BUY: {{ticker}} closed above the 15m opening range high with volume confirmation at {{close}}")
alertcondition(sellSignal, "ORB SELL", "ORB SELL: {{ticker}} closed below the 15m opening range low with volume confirmation at {{close}}")

// ============================================================================
// INFO TABLE
// ============================================================================

var table info = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 20), border_width = 1)

if showTable and barstate.islast
    string status = na(orHigh) ? "Waiting for range" : not rangeLive ? "Session closed" : signalsToday >= maxSignals ? "Done for day" : inEntryWindow ? "Watching breakout" : "Outside signal window"
    table.cell(info, 0, 0, "ORB 15m", text_color = color.white)
    table.cell(info, 1, 0, status, text_color = color.yellow)
    table.cell(info, 0, 1, "Range high", text_color = color.white)
    table.cell(info, 1, 1, str.tostring(orHigh, format.mintick), text_color = colHigh)
    table.cell(info, 0, 2, "Range low", text_color = color.white)
    table.cell(info, 1, 2, str.tostring(orLow, format.mintick), text_color = colLow)
    table.cell(info, 0, 3, "Range size", text_color = color.white)
    table.cell(info, 1, 3, str.tostring(orRange, format.mintick), text_color = color.white)
    table.cell(info, 0, 4, "Volume ratio", text_color = color.white)
    table.cell(info, 1, 4, na(volRatio) ? "n/a" : str.tostring(volRatio, "#.##") + "x", text_color = volOk ? color.lime : color.gray)
    table.cell(info, 0, 5, "Last signal", text_color = color.white)
    table.cell(info, 1, 5, lastSignal, text_color = color.white)
