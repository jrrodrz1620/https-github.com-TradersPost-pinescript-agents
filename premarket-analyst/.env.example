# Resend API key: sign up free at resend.com, then Dashboard -> API Keys -> Create API Key (starts with "re_")
RESEND_API_KEY=

# Where the report lands. On Resend's free sandbox sender this must be the email on your Resend account
EMAIL_TO=

# Optional: sender identity. Default is the Resend sandbox address. Verify a domain in Resend to use your own
# EMAIL_FROM=AI Premarket Analyst <onboarding@resend.dev>

# ---- Second brain (bin/grok-ask.sh / bin/grok-ask.ps1) ----
# Any OpenAI-compatible chat API works. Set the three SECOND_BRAIN_* values
# (or just XAI_API_KEY for the Grok default). Ready-made configs:
#
# xAI Grok (default, pay per use, console.x.ai):
#   SECOND_BRAIN_KEY=xai-...
#   (URL and MODEL defaults already point at Grok)
#
# Google Gemini (FREE tier, no card, aistudio.google.com/apikey):
#   SECOND_BRAIN_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   SECOND_BRAIN_MODEL=gemini-2.5-flash
#   SECOND_BRAIN_KEY=AIza...
#
# Kimi / Moonshot (signup credits then very cheap, platform.moonshot.ai):
#   SECOND_BRAIN_URL=https://api.moonshot.ai/v1/chat/completions
#   SECOND_BRAIN_MODEL=kimi-k2-0905-preview
#   SECOND_BRAIN_KEY=sk-...
#
# DeepSeek (very cheap, platform.deepseek.com):
#   SECOND_BRAIN_URL=https://api.deepseek.com/chat/completions
#   SECOND_BRAIN_MODEL=deepseek-chat
#   SECOND_BRAIN_KEY=sk-...
#
# OpenRouter (some free models, openrouter.ai):
#   SECOND_BRAIN_URL=https://openrouter.ai/api/v1/chat/completions
#   SECOND_BRAIN_MODEL=deepseek/deepseek-chat-v3.1:free
#   SECOND_BRAIN_KEY=sk-or-...
SECOND_BRAIN_URL=
SECOND_BRAIN_MODEL=
SECOND_BRAIN_KEY=

# Legacy shortcut: if only this is set, the wrapper uses Grok defaults
XAI_API_KEY=
