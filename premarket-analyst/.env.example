# Resend API key: sign up free at resend.com, then Dashboard -> API Keys -> Create API Key (starts with "re_")
RESEND_API_KEY=

# Where the report lands. On Resend's free sandbox sender this must be the email on your Resend account
EMAIL_TO=

# Optional: sender identity. Default is the Resend sandbox address. Verify a domain in Resend to use your own
# EMAIL_FROM=AI Premarket Analyst <onboarding@resend.dev>

# Optional: xAI key for the real Grok second brain (bin/grok-ask.sh). Get one at console.x.ai
XAI_API_KEY=
